
/* IRGEZTNE Workspace Cabinet v0 */

body.ir-wc-v0-ready .workspace-shell .workspace-shell-nav {
  display: none !important;
}

.workspace-shell .workspace-panel[data-panel="workspace"] {
  padding: 14px !important;
}

.ir-wc-v0 {
  display: grid;
  gap: 14px;
  color: #eaf2ff;
}

.ir-wc-hero,
.ir-wc-card {
  border: 1px solid rgba(105, 165, 255, 0.24);
  background:
    radial-gradient(circle at 0% 0%, rgba(71, 139, 255, 0.16), transparent 34%),
    linear-gradient(180deg, rgba(14, 40, 76, 0.92), rgba(5, 17, 34, 0.96));
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
  border-radius: 20px;
}

.ir-wc-hero {
  padding: 16px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
}

.ir-wc-kicker {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(126, 185, 255, 0.9);
  margin-bottom: 6px;
}

.ir-wc-hero h2 {
  margin: 0;
  font-size: 22px;
  line-height: 1.1;
}

.ir-wc-hero p,
.ir-wc-card p {
  margin: 7px 0 0;
  color: rgba(205, 220, 240, 0.78);
  line-height: 1.45;
  font-size: 13px;
}

.ir-wc-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.ir-wc-card {
  padding: 14px;
  overflow: hidden;
}

.ir-wc-card-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.ir-wc-card-head span {
  display: inline-grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 9px;
  background: rgba(57, 124, 255, 0.18);
  color: #7bb4ff;
}

.ir-wc-time {
  font-size: 34px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.ir-wc-date {
  margin-top: 8px;
  color: rgba(205, 220, 240, 0.76);
  text-transform: capitalize;
}

.ir-wc-calendar-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  text-transform: capitalize;
}

.ir-wc-week,
.ir-wc-days {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 5px;
  text-align: center;
}

.ir-wc-week span {
  font-size: 10px;
  color: rgba(200, 215, 240, 0.58);
}

.ir-wc-day {
  min-height: 26px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  color: rgba(235, 244, 255, 0.78);
  background: rgba(255, 255, 255, 0.035);
  font-size: 12px;
}

.ir-wc-day:empty {
  background: transparent;
}

.ir-wc-day.is-today {
  background: linear-gradient(135deg, rgba(74, 144, 255, 0.95), rgba(50, 214, 148, 0.72));
  color: white;
  font-weight: 800;
}

.ir-wc-note textarea {
  width: 100%;
  min-height: 92px;
  resize: vertical;
  border-radius: 14px;
  border: 1px solid rgba(105, 165, 255, 0.22);
  background: rgba(2, 12, 26, 0.72);
  color: #eaf2ff;
  padding: 10px;
  outline: none;
  font: inherit;
}

.ir-wc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.ir-wc-primary,
.ir-wc-card button,
.ir-wc-actions button {
  border: 1px solid rgba(105, 165, 255, 0.28);
  background: linear-gradient(180deg, rgba(36, 91, 171, 0.9), rgba(20, 54, 108, 0.92));
  color: #f4f8ff;
  border-radius: 12px;
  padding: 8px 10px;
  font-weight: 700;
  cursor: pointer;
}

.ir-wc-primary:hover,
.ir-wc-card button:hover,
.ir-wc-actions button:hover {
  transform: translateY(-1px);
  border-color: rgba(125, 190, 255, 0.58);
}

@media (min-width: 760px) {
  .workspace-shell .workspace-panel[data-panel="workspace"] .ir-wc-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .ir-wc-hero {
    grid-template-columns: 1fr;
  }
}


